<Window x:Class="CyaNotch.Views.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CyaNotch.Views"
        xmlns:tabs="clr-namespace:CyaNotch.Views.Tabs"
        Title="CyaNotch Island"
        Width="200" Height="34" Left="-10000" Top="0"
        WindowStyle="None" AllowsTransparency="False" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        ShowActivated="False" UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <!-- Clipboard row -->
        <DataTemplate x:Key="ClipRow">
            <Border x:Name="Row" Background="Transparent" CornerRadius="12" Padding="10,8" Margin="0,1"
                    Cursor="Hand" MouseLeftButtonUp="Clip_Click" ToolTip="Click to paste">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                    <StackPanel Grid.Column="1" Margin="4,0,8,0">
                        <Image Source="{Binding Thumbnail}" MaxHeight="64" HorizontalAlignment="Left" Stretch="Uniform" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Grid Grid.Column="2" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PinMark" Style="{StaticResource Icon}" Text="&#xE840;" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" Visibility="{Binding Pinned, Converter={StaticResource BoolVis}}"/>
                            <TextBlock x:Name="WhenText" Text="{Binding When}" Style="{StaticResource Sub}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel x:Name="Actions" Orientation="Horizontal" Visibility="Collapsed" Margin="0,-6,0,0">
                            <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12" Content="&#xE718;" ToolTip="Pin / unpin" Click="ClipPin_Click"/>
                            <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12" Content="&#xE74D;" ToolTip="Delete" Click="ClipDelete_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}"/>
                    <Setter TargetName="Actions" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="WhenText" Property="Visibility" Value="Hidden"/>
                    <Setter TargetName="PinMark" Property="Visibility" Value="Hidden"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Shelf tile -->
        <DataTemplate x:Key="ShelfTile">
            <Border x:Name="Tile" Width="92" Height="96" CornerRadius="14" Margin="3" Padding="6" Background="Transparent"
                    ToolTip="{Binding Path}" Cursor="Hand"
                    PreviewMouseLeftButtonDown="Shelf_MouseDown" MouseMove="Shelf_MouseMove" MouseLeftButtonUp="Shelf_MouseUp">
                <Border.ContextMenu>
                    <ContextMenu Opened="ShelfMenu_Opened">
                        <MenuItem Header="Open" Click="ShelfOpen_Click"/>
                        <MenuItem Header="Show in folder" Click="ShelfReveal_Click"/>
                        <MenuItem Header="Move to" x:Name="MoveTo"/>
                        <Separator/>
                        <MenuItem Header="Remove from shelf" Click="ShelfRemove_Click"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Image Source="{Binding Icon}" Width="44" Height="44" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="30"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Tile" Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding Exists}" Value="False">
                    <Setter TargetName="Tile" Property="Opacity" Value="0.4"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Notification row -->
        <DataTemplate x:Key="NoteRow">
            <Border x:Name="Row" Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="12,8" Margin="0,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Sub}" Text="{Binding App}"/>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Body}" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SubTextBrush}"/>
                    </StackPanel>
                    <Grid Grid.Column="1" VerticalAlignment="Top">
                        <TextBlock x:Name="WhenText" Style="{StaticResource Sub}" Text="{Binding When}"/>
                        <Button x:Name="Del" Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="11" Content="&#xE711;" Visibility="Collapsed" Margin="0,-4,0,0" Click="NoteDelete_Click"/>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Del" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="WhenText" Property="Visibility" Value="Hidden"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Reminder row -->
        <DataTemplate x:Key="ReminderRow">
            <Border x:Name="Row" Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="10,6" Margin="0,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="Due" Style="{StaticResource Sub}" Text="{Binding DueText}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12" Content="&#xE916;" ToolTip="Snooze 10 minutes" Click="ReminderSnooze_Click"/>
                        <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12" Content="&#xE73E;" ToolTip="Done" Click="ReminderDone_Click"/>
                        <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12" Content="&#xE74D;" ToolTip="Delete" Click="ReminderDelete_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Overdue}" Value="True">
                    <Setter TargetName="Due" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- To-do row -->
        <DataTemplate x:Key="TodoRow">
            <Border x:Name="Row" Background="Transparent" CornerRadius="10" Padding="6,4" Margin="0,1" Cursor="Hand" MouseLeftButtonUp="Todo_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="Check" Style="{StaticResource Icon}" Text="&#xE739;" Foreground="{DynamicResource SubTextBrush}"/>
                    <TextBlock x:Name="Label" Grid.Column="1" Text="{Binding Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="Del" Grid.Column="2" Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="10" Content="&#xE711;" Visibility="Hidden" Click="TodoDelete_Click"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Done}" Value="True">
                    <Setter TargetName="Check" Property="Text" Value="&#xE73D;"/>
                    <Setter TargetName="Check" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                    <Setter TargetName="Label" Property="TextDecorations" Value="Strikethrough"/>
                    <Setter TargetName="Label" Property="Opacity" Value="0.5"/>
                </DataTrigger>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}"/>
                    <Setter TargetName="Del" Property="Visibility" Value="Visible"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root" TextElement.Foreground="{DynamicResource TextBrush}" TextElement.FontFamily="{StaticResource UiFont}" TextElement.FontSize="13">
        <!-- The island. Its size and corner radius are animated from code. -->
        <Border x:Name="Island"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Width="200" Height="34" CornerRadius="17"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource SurfaceEdgeBrush}" BorderThickness="1"
                AllowDrop="True" ClipToBounds="True"
                MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave"
                MouseLeftButtonUp="Island_Click" MouseWheel="Island_MouseWheel"
                DragEnter="Island_DragEnter" DragOver="Island_DragOver" DragLeave="Island_DragLeave" Drop="Island_Drop">

            <Grid>
                <!-- ambient: a soft blur of the song's artwork tinting the whole island -->
                <Grid x:Name="Ambient" IsHitTestVisible="False" Opacity="0" Visibility="Collapsed">
                    <Border Margin="-30">
                        <Border.Background>
                            <ImageBrush x:Name="AmbientArt" Stretch="UniformToFill"/>
                        </Border.Background>
                        <Border.Effect>
                            <BlurEffect Radius="34" RenderingBias="Performance"/>
                        </Border.Effect>
                    </Border>
                    <Border Background="#8C000000"/>
                </Grid>

                <!-- glossy sheen layer -->
                <Border Background="{DynamicResource SheenBrush}" IsHitTestVisible="False" CornerRadius="{Binding CornerRadius, ElementName=Island}"/>

                <!-- ============ COMPACT ============ -->
                <Grid x:Name="Compact" Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- music visualizer: spans the whole pill while something is playing -->
                    <local:VisualizerBars x:Name="Viz" Grid.ColumnSpan="3" Margin="4,7" Visibility="Collapsed"
                                          BarBrush="{DynamicResource MediaVizBrush}" IsHitTestVisible="False"/>

                    <!-- left: artwork or status icon -->
                    <Grid Grid.Column="0" VerticalAlignment="Center">
                        <Border x:Name="CompactArtBox" Width="22" Height="22" CornerRadius="6" Visibility="Collapsed">
                            <Border.Background>
                                <ImageBrush x:Name="CompactArt" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <TextBlock x:Name="CompactIcon" Style="{StaticResource Icon}" FontSize="13" Text="&#xE823;" Foreground="{DynamicResource SubTextBrush}"/>
                    </Grid>

                    <!-- centre: time, title, timer -->
                    <TextBlock x:Name="CompactText" Grid.Column="1" Margin="8,0" VerticalAlignment="Center" HorizontalAlignment="Center"
                               FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="12:00"
                               SizeChanged="CompactText_SizeChanged"/>

                    <!-- right: equaliser / mic / call timer -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel x:Name="AgentPill" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,6,0" ToolTip="Coding agents">
                            <Ellipse x:Name="AgentDot" Width="7" Height="7" Fill="#FFB020" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock x:Name="AgentCount" FontSize="11.5" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel x:Name="RecPill" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,6,0">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource DangerBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock x:Name="RecTime" FontSize="11.5" FontWeight="SemiBold" Text="REC" Foreground="{StaticResource DangerBrush}"/>
                        </StackPanel>
                        <StackPanel x:Name="CallPill" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,6,0">
                            <Ellipse Width="7" Height="7" Fill="#3DDC84" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock x:Name="CallTime" FontSize="11.5" FontWeight="SemiBold" Text="0:00" Foreground="#3DDC84"/>
                        </StackPanel>
                        <TextBlock x:Name="MicMutedIcon" Style="{StaticResource Icon}" FontSize="13" Text="&#xEC54;" Foreground="{StaticResource DangerBrush}" Visibility="Collapsed" Margin="0,0,6,0" ToolTip="Microphone muted (Ctrl+Alt+M)"/>
                        <TextBlock x:Name="CompactRight" Style="{StaticResource Sub}" VerticalAlignment="Center"/>
                        <local:VisualizerBars x:Name="DotViz" Dots="True" DotRows="4" Width="28" Height="13" VerticalAlignment="Center"
                                              BarBrush="{DynamicResource MediaVizBrush}" IsHitTestVisible="False" Visibility="Collapsed" Margin="4,0,2,0"/>
                    </StackPanel>
                </Grid>

                <!-- ============ GAME STRIP (fullscreen games) ============ -->
                <StackPanel x:Name="Strip" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" TextElement.FontSize="11.5">
                    <TextBlock x:Name="StripTime" FontWeight="SemiBold" Margin="0,0,12,0"/>
                    <TextBlock x:Name="StripFps" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0"/>
                    <TextBlock x:Name="StripCpu" Margin="0,0,10,0"/>
                    <TextBlock x:Name="StripGpu" Margin="0,0,10,0"/>
                    <TextBlock x:Name="StripRam"/>
                </StackPanel>

                <!-- ============ PEEK (notification / reminder / status) ============ -->
                <Grid x:Name="Peek" Margin="14,8" Visibility="Collapsed" Opacity="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource CardBrush}" VerticalAlignment="Center">
                        <TextBlock x:Name="PeekIcon" Style="{StaticResource Icon}" Text="&#xEA8F;" Foreground="{DynamicResource AccentBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="PeekTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="PeekBody" Style="{StaticResource Sub}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock x:Name="PeekCount" Grid.Column="1" Style="{StaticResource Sub}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top"
                               Visibility="Collapsed" ToolTip="Scroll to flip through"/>
                </Grid>

                <!-- ============ EXPANDED ============ -->
                <DockPanel x:Name="Expanded" Margin="12,5,12,10" Visibility="Collapsed" Opacity="0">
                    <!-- top row: record, the tabs, settings -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                        <Button x:Name="HeaderRec" Style="{StaticResource HeaderIcon}" Width="26" ToolTip="Capture and record" Click="HeaderRec_Click">
                            <Grid Width="17" Height="17" Margin="0,3,0,0">
                                <Ellipse x:Name="RecRing" Fill="{StaticResource DangerBrush}"/>
                                <Rectangle x:Name="RecMark" Width="6.5" Height="6.5" RadiusX="3.25" RadiusY="3.25" Fill="White"/>
                            </Grid>
                        </Button>
                        <Rectangle Width="1" Height="12" Fill="{DynamicResource TrackBrush}" Margin="5,0,5,0" VerticalAlignment="Center"/>
                        <RadioButton x:Name="TabHome" Style="{StaticResource TabButton}" Content="&#xEC4F;" ToolTip="Music" IsChecked="True" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabWeb" Style="{StaticResource TabButton}" Content="&#xE774;" ToolTip="Web" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabNotes" Style="{StaticResource TabButton}" Content="&#xEA8F;" ToolTip="Notifications" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabShelf" Style="{StaticResource TabButton}" Content="&#xE8B7;" ToolTip="Shelf" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabClip" Style="{StaticResource TabButton}" Content="&#xE77F;" ToolTip="Clipboard" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabWidgets" Style="{StaticResource TabButton}" Content="&#xF0E2;" ToolTip="Widgets" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabControls" Style="{StaticResource TabButton}" Content="&#xE9E9;" ToolTip="Controls" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabLauncher" Style="{StaticResource TabButton}" Content="&#xE712;" ToolTip="Launcher" Checked="Tab_Checked"/>
                        <Button x:Name="HeaderPhone" Style="{StaticResource HeaderIcon}" Content="&#xE8EA;" ToolTip="Phone remote" Click="HeaderPhone_Click"/>
                        <RadioButton x:Name="TabCalls" Style="{StaticResource TabButton}" Content="&#xE7F6;" ToolTip="Calls" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabAgents" Style="{StaticResource TabButton}" Content="&#xE99A;" ToolTip="AI agents" Checked="Tab_Checked"/>
                        <!-- reached from the record button and the widgets, not the top row -->
                        <RadioButton x:Name="TabStream" Style="{StaticResource TabButton}" Visibility="Collapsed" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabFocus" Style="{StaticResource TabButton}" Visibility="Collapsed" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabReminders" Style="{StaticResource TabButton}" Visibility="Collapsed" Checked="Tab_Checked"/>
                        <Rectangle Width="1" Height="12" Fill="{DynamicResource TrackBrush}" Margin="5,0,5,0" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource HeaderIcon}" Content="&#xE713;" ToolTip="Settings" Click="Settings_Click"/>
                    </StackPanel>

                    <Grid x:Name="PagesHost">
                    <Grid x:Name="QrOverlay" Visibility="Collapsed" Panel.ZIndex="10" Background="{DynamicResource SurfaceBrush}">
                        <Grid Margin="2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="White" CornerRadius="14" Padding="7" VerticalAlignment="Center">
                                <Image x:Name="QrImage" Width="132" Height="132" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Phone remote" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Sub}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="Scan with your phone on the same Wi-Fi. Approve it here the first time."/>
                                <TextBox x:Name="QrUrl" Style="{StaticResource Field}" IsReadOnly="True" FontSize="11" Margin="0,8,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Style="{StaticResource AccentPill}" Content="Done" Click="QrClose_Click"/>
                                    <Button Style="{StaticResource PillButton}" Content="Turn off" Margin="6,0,0,0" Click="DeckToggle_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <Grid x:Name="Pages">
                        <!-- ===== MUSIC ===== -->
                        <Grid x:Name="PageHome" Margin="4,0,4,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- artwork, song, controls -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="66" Height="66">
                                    <Border CornerRadius="12" Background="{DynamicResource TrackBrush}" Margin="0,0,6,6">
                                        <Grid>
                                            <TextBlock x:Name="ArtPlaceholder" Style="{StaticResource Icon}" FontSize="20" Text="&#xEC4F;" Foreground="{DynamicResource SubTextBrush}"/>
                                            <Border CornerRadius="12">
                                                <Border.Background>
                                                    <ImageBrush x:Name="MediaArt" Stretch="UniformToFill"/>
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <!-- app badge in the artwork's corner -->
                                    <Border x:Name="AppBadge" Width="22" Height="22" CornerRadius="7" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Background="{DynamicResource MediaAccentBrush}" BorderBrush="#99000000" BorderThickness="1.5" ToolTip="{Binding Text, ElementName=MediaApp}">
                                        <Grid>
                                            <Image x:Name="AppBadgeIcon" Width="13" Height="13" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock x:Name="AppBadgeGlyph" Style="{StaticResource Icon}" FontSize="10" Text="&#xEC4F;" Foreground="#E6000000"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="10,0,6,4" VerticalAlignment="Center">
                                    <TextBlock x:Name="MediaTitle" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="MediaArtist" FontSize="12.5" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                    <TextBlock x:Name="MediaApp" Visibility="Collapsed" Text="Nothing playing"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                    <Button Style="{StaticResource IconButton}" Width="34" Height="34" FontSize="15" Content="&#xE892;" Click="Prev_Click"/>
                                    <Button x:Name="PlayPause" Style="{StaticResource IconButton}" Width="38" Height="38" FontSize="21" Content="&#xE768;" Margin="2,0" Click="PlayPause_Click"/>
                                    <Button Style="{StaticResource IconButton}" Width="34" Height="34" FontSize="15" Content="&#xE893;" Click="Next_Click"/>
                                </StackPanel>
                            </Grid>

                            <!-- lyrics, when they're on -->
                            <StackPanel x:Name="LyricsBox" Grid.Row="1" Margin="2,4,2,0" Visibility="Collapsed">
                                <TextBlock x:Name="LyricPrev" Style="{StaticResource Sub}" FontSize="11" TextTrimming="CharacterEllipsis" Opacity="0.7"/>
                                <TextBlock x:Name="LyricNow" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MediaAccentBrush}" TextTrimming="CharacterEllipsis" Margin="0,1"/>
                                <TextBlock x:Name="LyricNext" Style="{StaticResource Sub}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <local:WavyProgress x:Name="MediaProgress" Grid.Row="2" Margin="0,6,0,0" Brush="{DynamicResource MediaAccentBrush}" Track="{DynamicResource TrackBrush}"/>
                            <Grid Grid.Row="3" Margin="0,3,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="56"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="MediaPos" Style="{StaticResource Sub}" FontFamily="Consolas" FontSize="11.5" Text="0:00" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE767;" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,6,0"/>
                                    <Slider x:Name="CardVolume" Style="{StaticResource ThinSlider}" Width="84" Minimum="0" Maximum="100" VerticalAlignment="Center" ValueChanged="CardVolume_Changed"/>
                                    <ToggleButton x:Name="LyricsToggle" Style="{StaticResource LyricsToggle}" FontSize="12" Margin="8,0,0,0" ToolTip="Lyrics" Click="LyricsToggle_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="MediaDur" Grid.Column="2" Style="{StaticResource Sub}" FontFamily="Consolas" FontSize="11.5" Text="0:00" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>

                        <!-- ===== WIDGETS ===== -->
                        <Grid x:Name="PageWidgets" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition Height="6"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <!-- today: date and this week -->
                            <Border Style="{StaticResource WTile}" ToolTip="Today">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Pin clock to desktop" Tag="Clock" Click="PinWidget_Click"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="CalDay" FontSize="22" FontWeight="SemiBold" Text="19" VerticalAlignment="Center"/>
                                        <StackPanel Margin="5,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="CalDow" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Text="THU"/>
                                            <TextBlock x:Name="CalMonth" FontSize="9.5" Text="NOV"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock x:Name="CalWeek" Style="{StaticResource Sub}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                    <UniformGrid x:Name="CalDays" Grid.Row="1" Columns="7" Rows="2" VerticalAlignment="Bottom" TextElement.FontSize="9.5"/>
                                </Grid>
                            </Border>

                            <!-- focus timer -->
                            <Border Grid.Column="2" Style="{StaticResource WTile}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="48" Height="48" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="FocusRing_Click" ToolTip="Open Focus">
                                        <Ellipse Stroke="{DynamicResource TrackBrush}" StrokeThickness="3"/>
                                        <Ellipse x:Name="FocusArc" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3" RenderTransformOrigin="0.5,0.5"
                                                 StrokeDashCap="Round" StrokeDashArray="0 100">
                                            <Ellipse.RenderTransform>
                                                <RotateTransform Angle="-90"/>
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                        <TextBlock x:Name="FocusLeft" FontFamily="Consolas" FontSize="10.5" FontWeight="SemiBold" Text="25:00" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="FocusTitle" FontSize="12" FontWeight="SemiBold" Text="Focus timer"/>
                                        <TextBlock x:Name="FocusLengths" Style="{StaticResource Sub}" FontSize="10.5" Text="25 + 5 min"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Button x:Name="FocusGo" Width="20" Height="20" Cursor="Hand" Focusable="False" Click="FocusGo_Click" ToolTip="Start or stop">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Grid>
                                                            <Ellipse Fill="#F2F2F2"/>
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <TextBlock x:Name="FocusGoGlyph" FontFamily="{StaticResource IconFont}" FontSize="9" Foreground="#111111" Text="&#xE768;"/>
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" Width="20" Height="20" FontSize="9" Content="&#xE738;" Margin="6,0,0,0" Tag="-5" Click="FocusLen_Click" ToolTip="5 minutes less"/>
                                            <Button Style="{StaticResource IconButton}" Width="20" Height="20" FontSize="9" Content="&#xE710;" Margin="2,0,0,0" Tag="5" Click="FocusLen_Click" ToolTip="5 minutes more"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- reminders: a bell between the top cards -->
                            <Button Grid.ColumnSpan="3" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-15"
                                    Panel.ZIndex="2" Cursor="Hand" Focusable="False" Click="WidgetBell_Click" ToolTip="Reminders and to-do">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Ellipse Fill="{DynamicResource SurfaceBrush}" Stroke="{DynamicResource TrackBrush}" StrokeThickness="1"/>
                                            <TextBlock FontFamily="{StaticResource IconFont}" FontSize="10" Text="&#xEA8F;" Foreground="{DynamicResource SubTextBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- PC stats -->
                            <Border Grid.Row="2" Style="{StaticResource WTile}">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Pin to desktop" Tag="Stats" Click="PinWidget_Click"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid TextElement.FontSize="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="CPU" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Text="GPU" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="2" Text="RAM" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                                    <Polyline x:Name="CpuSpark" Grid.Column="1" Grid.RowSpan="3" Stroke="#4FA3FF" StrokeThickness="1.3" Stretch="None" StrokeLineJoin="Round" Margin="2,0"/>
                                    <Polyline x:Name="GpuSpark" Grid.Column="1" Grid.RowSpan="3" Stroke="#B36BFF" StrokeThickness="1.3" Stretch="None" StrokeLineJoin="Round" Margin="2,0"/>
                                    <Polyline x:Name="RamSpark" Grid.Column="1" Grid.RowSpan="3" Stroke="#F5A623" StrokeThickness="1.3" Stretch="None" StrokeLineJoin="Round" Margin="2,0"/>
                                    <Canvas x:Name="SparkBox" Grid.Column="1" Grid.RowSpan="3" Margin="2,0"/>
                                    <TextBlock x:Name="CpuText" Grid.Column="2" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="GpuText" Grid.Column="2" Grid.Row="1" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RamText" Grid.Column="2" Grid.Row="2" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CpuTempText" Grid.Column="3" FontWeight="SemiBold" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="NetText" Grid.Row="3" Grid.ColumnSpan="4" FontFamily="Consolas" FontSize="9.5" Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,0" Text="↓ 0 B/s   ↑ 0 B/s"/>
                                </Grid>
                            </Border>

                            <!-- weather -->
                            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource WTile}" Cursor="Hand" MouseLeftButtonUp="Weather_Click">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Pin to desktop" Tag="Weather" Click="PinWidget_Click"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <TextBlock x:Name="WeatherTemp" FontSize="22" FontWeight="SemiBold" Text="--°" VerticalAlignment="Top"/>
                                    <TextBlock x:Name="WeatherIcon" Style="{StaticResource Icon}" FontSize="17" Text="&#xE706;" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,2,0"/>
                                    <TextBlock x:Name="WeatherDesc" Style="{StaticResource Sub}" FontSize="10.5" Text="Set your city in Settings" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" Margin="0,0,62,0"/>
                                    <TextBlock x:Name="WeatherHiLo" Style="{StaticResource Sub}" FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ===== NEW TABS ===== -->
                        <tabs:WebPage x:Name="PageWeb" Visibility="Collapsed"/>
                        <tabs:LauncherPage x:Name="PageLauncher" Visibility="Collapsed"/>
                        <tabs:FocusPage x:Name="PageFocus" Visibility="Collapsed"/>
                        <tabs:CallsPage x:Name="PageCalls" Visibility="Collapsed"/>
                        <tabs:StreamPage x:Name="PageStream" Visibility="Collapsed"/>
                        <tabs:AgentsPage x:Name="PageAgents" Visibility="Collapsed"/>

                        <!-- ===== CLIPBOARD ===== -->
                        <DockPanel x:Name="PageClip" Visibility="Collapsed">
                            <Grid DockPanel.Dock="Top" Margin="4,0,4,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton Style="{StaticResource Chip}" Content="All" Tag="All" IsChecked="True" GroupName="ClipFilter" Checked="ClipFilter_Checked"/>
                                    <RadioButton Style="{StaticResource Chip}" Content="Pinned" Tag="Pinned" GroupName="ClipFilter" Checked="ClipFilter_Checked"/>
                                    <RadioButton Style="{StaticResource Chip}" Content="Text" Tag="Text" GroupName="ClipFilter" Checked="ClipFilter_Checked"/>
                                    <RadioButton Style="{StaticResource Chip}" Content="Links" Tag="Link" GroupName="ClipFilter" Checked="ClipFilter_Checked"/>
                                    <RadioButton Style="{StaticResource Chip}" Content="Images" Tag="Image" GroupName="ClipFilter" Checked="ClipFilter_Checked"/>
                                    <RadioButton Style="{StaticResource Chip}" Content="Files" Tag="Files" GroupName="ClipFilter" Checked="ClipFilter_Checked"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBox x:Name="ClipSearch" Style="{StaticResource Field}" Width="160" Tag="Search" TextChanged="ClipSearch_Changed"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Clear all except pinned" Click="ClipClear_Click" Margin="4,0,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <ListBox x:Name="ClipList" Style="{StaticResource PlainList}" ItemTemplate="{StaticResource ClipRow}"/>
                                <TextBlock x:Name="ClipEmpty" Style="{StaticResource Sub}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Copy something and it shows up here." Visibility="Collapsed"/>
                            </Grid>
                        </DockPanel>

                        <!-- ===== SHELF ===== -->
                        <Grid x:Name="PageShelf" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DockPanel Margin="0,0,8,0">
                                <Button DockPanel.Dock="Bottom" Style="{StaticResource PillButton}" Content="+ New folder" Click="ShelfNewFolder_Click" Margin="0,6,0,0"/>
                                <ListBox x:Name="FolderList" Style="{StaticResource PlainList}" SelectionChanged="Folder_Changed">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Row" CornerRadius="10" Padding="10,7" Margin="0,1" Background="Transparent" Cursor="Hand"
                                                    AllowDrop="True" Drop="Folder_Drop" MouseLeftButtonUp="Folder_Click">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Delete folder" Click="FolderDelete_Click"/>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="13" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource CardBrush}"/>
                                                </DataTrigger>
                                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                            <Border Grid.Column="1" x:Name="ShelfDrop" CornerRadius="16" BorderThickness="1.5" BorderBrush="{DynamicResource TrackBrush}" Background="Transparent">
                                <Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="ShelfItems" ItemTemplate="{StaticResource ShelfTile}" Margin="6">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <StackPanel x:Name="ShelfEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock Style="{StaticResource Icon}" FontSize="28" Text="&#xE896;" Foreground="{DynamicResource SubTextBrush}"/>
                                        <TextBlock Style="{StaticResource Sub}" Margin="0,8,0,0" Text="Drop files on the island to keep them here."/>
                                        <TextBlock Style="{StaticResource Sub}" HorizontalAlignment="Center" Text="Drag them back out into any app."/>
                                    </StackPanel>
                                    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6" Content="&#xE74D;" ToolTip="Clear this folder" Click="ShelfClear_Click"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ===== CONTROLS ===== -->
                        <Grid x:Name="PageControls" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54"/>
                                <ColumnDefinition Width="54"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <local:FillSlider x:Name="BrightnessSlider" Glyph="&#xE706;" Margin="3,3,4,3" ToolTip="Brightness"
                                              ValueChanged="Brightness_Changed" Committed="Brightness_Commit"/>
                            <local:FillSlider x:Name="VolumeSlider" Grid.Column="1" Glyph="&#xE767;" Margin="3,3,4,3" ToolTip="Volume"
                                              ValueChanged="Volume_Changed"/>
                            <UniformGrid Grid.Column="2" Columns="3" Rows="2">
                                <ToggleButton x:Name="WifiTile" Style="{StaticResource QuickTile}" Tag="#2F8CFF" Click="Wifi_Click">
                                    <StackPanel>
                                        <Grid HorizontalAlignment="Left">
                                            <Ellipse Style="{StaticResource TileDot}"/>
                                            <TextBlock x:Name="WifiTileGlyph" FontFamily="{StaticResource IconFont}" FontSize="11" Text="&#xE701;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Text="Wi-Fi" FontSize="11.5" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="WifiState" FontSize="10.5" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="BtTile" Style="{StaticResource QuickTile}" Tag="#2F8CFF" Click="Bluetooth_Click">
                                    <StackPanel>
                                        <Grid HorizontalAlignment="Left">
                                            <Ellipse Style="{StaticResource TileDot}"/>
                                            <TextBlock x:Name="BtTileGlyph" FontFamily="{StaticResource IconFont}" FontSize="11" Text="&#xE702;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Text="Bluetooth" FontSize="11.5" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="BtState" FontSize="10.5" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="NightTile" Style="{StaticResource QuickTile}" Tag="#F5A623" Click="NightLight_Click">
                                    <StackPanel>
                                        <Grid HorizontalAlignment="Left">
                                            <Ellipse Style="{StaticResource TileDot}"/>
                                            <TextBlock x:Name="NightTileGlyph" FontFamily="{StaticResource IconFont}" FontSize="11" Text="&#xE708;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Text="Night light" FontSize="11.5" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="NightState" FontSize="10.5" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="FocusTile" Style="{StaticResource QuickTile}" Tag="#8E7CFF" Click="Focus_Click" ToolTip="Do not disturb: Windows and the island stay quiet">
                                    <StackPanel>
                                        <Grid HorizontalAlignment="Left">
                                            <Ellipse Style="{StaticResource TileDot}"/>
                                            <TextBlock x:Name="FocusTileGlyph" FontFamily="{StaticResource IconFont}" FontSize="11" Text="&#xE7ED;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Text="Focus" FontSize="11.5" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="FocusState" FontSize="10.5" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="MuteTile" Style="{StaticResource QuickTile}" Tag="#FF5F57" Click="SpeakerMute_Click">
                                    <StackPanel>
                                        <Grid HorizontalAlignment="Left">
                                            <Ellipse Style="{StaticResource TileDot}"/>
                                            <TextBlock x:Name="MuteTileGlyph" FontFamily="{StaticResource IconFont}" FontSize="11" Text="&#xE767;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Text="Mute" FontSize="11.5" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="MuteState" FontSize="10.5" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="BatteryTile" Style="{StaticResource QuickTile}" Tag="#3DDC84" Click="Battery_Click" ToolTip="Battery settings">
                                    <StackPanel>
                                        <Grid HorizontalAlignment="Left">
                                            <Ellipse Style="{StaticResource TileDot}"/>
                                            <TextBlock x:Name="BatteryTileGlyph" FontFamily="{StaticResource IconFont}" FontSize="11" Text="&#xE83F;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Text="Battery" FontSize="11.5" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="BatteryState" FontSize="10.5" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </ToggleButton>
                            </UniformGrid>
                            <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="3,4,3,0" CornerRadius="12" Background="#14FFFFFF" Padding="3">
                                <UniformGrid Columns="3">
                                    <RadioButton x:Name="PowerEff" Style="{StaticResource Seg}" Content="Battery" GroupName="Power" Click="Power_Click"/>
                                    <RadioButton x:Name="PowerBal" Style="{StaticResource Seg}" Content="Balanced" GroupName="Power" Click="Power_Click"/>
                                    <RadioButton x:Name="PowerPerf" Style="{StaticResource Seg}" Content="Performance" GroupName="Power" Click="Power_Click"/>
                                </UniformGrid>
                            </Border>
                        </Grid>

                        <!-- ===== NOTIFICATIONS ===== -->
                        <DockPanel x:Name="PageNotes" Visibility="Collapsed">
                            <Grid DockPanel.Dock="Top" Margin="4,0,4,6">
                                <TextBlock x:Name="NotesStatus" Style="{StaticResource Sub}" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource PillButton}" HorizontalAlignment="Right" Content="Clear all" Click="NotesClear_Click"/>
                            </Grid>
                            <Grid>
                                <ListBox x:Name="NotesList" Style="{StaticResource PlainList}" ItemTemplate="{StaticResource NoteRow}"/>
                                <TextBlock x:Name="NotesEmpty" Style="{StaticResource Sub}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="No notifications yet."/>
                            </Grid>
                        </DockPanel>

                        <!-- ===== REMINDERS + TO-DO ===== -->
                        <Grid x:Name="PageReminders" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="230"/>
                            </Grid.ColumnDefinitions>
                            <DockPanel Margin="0,0,10,0">
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ReminderText" Style="{StaticResource Field}" Tag="Remind me to…" KeyDown="ReminderInput_KeyDown"/>
                                    <TextBox x:Name="ReminderWhen" Grid.Column="1" Style="{StaticResource Field}" Tag="in 10m / 5pm" Margin="4,0,0,0" KeyDown="ReminderInput_KeyDown"/>
                                    <ComboBox x:Name="ReminderRepeat" Grid.Column="2" Margin="4,0,0,0" Width="90" VerticalContentAlignment="Center" SelectedIndex="0">
                                        <ComboBoxItem Content="Once"/>
                                        <ComboBoxItem Content="Daily"/>
                                        <ComboBoxItem Content="Weekdays"/>
                                        <ComboBoxItem Content="Weekly"/>
                                        <ComboBoxItem Content="Monthly"/>
                                    </ComboBox>
                                    <Button Grid.Column="3" Style="{StaticResource AccentPill}" Content="Add" Margin="4,0,0,0" Click="ReminderAdd_Click"/>
                                </Grid>
                                <TextBlock x:Name="ReminderHint" DockPanel.Dock="Top" Style="{StaticResource Sub}" Margin="4,0,0,4" Text="Try: in 20m, at 6pm, tomorrow 9am, 17:30"/>
                                <ListBox x:Name="ReminderList" Style="{StaticResource PlainList}" ItemTemplate="{StaticResource ReminderRow}"/>
                            </DockPanel>
                            <Border Grid.Column="1" Style="{StaticResource Tile}" Margin="0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Sub}" Text="To-do" Margin="2,0,0,6"/>
                                    <TextBox x:Name="TodoInput" DockPanel.Dock="Top" Style="{StaticResource Field}" Tag="Add a task and press Enter" KeyDown="TodoInput_KeyDown" Margin="0,0,0,6"/>
                                    <ListBox x:Name="TodoList" Style="{StaticResource PlainList}" ItemTemplate="{StaticResource TodoRow}"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                    </Grid>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
