<Window x:Class="CyaNotch.Views.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyaNotch Island"
        Width="760" Height="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        ShowActivated="False" UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <!-- Clipboard row -->
        <DataTemplate x:Key="ClipRow">
            <Border x:Name="Row" Background="Transparent" CornerRadius="12" Padding="10,8" Margin="0,1"
                    Cursor="Hand" MouseLeftButtonUp="Clip_Click" ToolTip="Click to paste">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                    <StackPanel Grid.Column="1" Margin="4,0,8,0">
                        <Image Source="{Binding Thumbnail}" MaxHeight="64" HorizontalAlignment="Left" Stretch="Uniform" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Grid Grid.Column="2" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PinMark" Style="{StaticResource Icon}" Text="&#xE840;" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" Visibility="{Binding Pinned, Converter={StaticResource BoolVis}}"/>
                            <TextBlock x:Name="WhenText" Text="{Binding When}" Style="{StaticResource Sub}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel x:Name="Actions" Orientation="Horizontal" Visibility="Collapsed" Margin="0,-6,0,0">
                            <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12" Content="&#xE718;" ToolTip="Pin / unpin" Click="ClipPin_Click"/>
                            <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12" Content="&#xE74D;" ToolTip="Delete" Click="ClipDelete_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}"/>
                    <Setter TargetName="Actions" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="WhenText" Property="Visibility" Value="Hidden"/>
                    <Setter TargetName="PinMark" Property="Visibility" Value="Hidden"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Shelf tile -->
        <DataTemplate x:Key="ShelfTile">
            <Border x:Name="Tile" Width="92" Height="96" CornerRadius="14" Margin="3" Padding="6" Background="Transparent"
                    ToolTip="{Binding Path}" Cursor="Hand"
                    PreviewMouseLeftButtonDown="Shelf_MouseDown" MouseMove="Shelf_MouseMove" MouseLeftButtonUp="Shelf_MouseUp">
                <Border.ContextMenu>
                    <ContextMenu Opened="ShelfMenu_Opened">
                        <MenuItem Header="Open" Click="ShelfOpen_Click"/>
                        <MenuItem Header="Show in folder" Click="ShelfReveal_Click"/>
                        <MenuItem Header="Move to" x:Name="MoveTo"/>
                        <Separator/>
                        <MenuItem Header="Remove from shelf" Click="ShelfRemove_Click"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Image Source="{Binding Icon}" Width="44" Height="44" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="30"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Tile" Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding Exists}" Value="False">
                    <Setter TargetName="Tile" Property="Opacity" Value="0.4"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Notification row -->
        <DataTemplate x:Key="NoteRow">
            <Border x:Name="Row" Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="12,8" Margin="0,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Sub}" Text="{Binding App}"/>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Body}" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SubTextBrush}"/>
                    </StackPanel>
                    <Grid Grid.Column="1" VerticalAlignment="Top">
                        <TextBlock x:Name="WhenText" Style="{StaticResource Sub}" Text="{Binding When}"/>
                        <Button x:Name="Del" Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="11" Content="&#xE711;" Visibility="Collapsed" Margin="0,-4,0,0" Click="NoteDelete_Click"/>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Del" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="WhenText" Property="Visibility" Value="Hidden"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Reminder row -->
        <DataTemplate x:Key="ReminderRow">
            <Border x:Name="Row" Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="10,6" Margin="0,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="Due" Style="{StaticResource Sub}" Text="{Binding DueText}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12" Content="&#xE916;" ToolTip="Snooze 10 minutes" Click="ReminderSnooze_Click"/>
                        <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12" Content="&#xE73E;" ToolTip="Done" Click="ReminderDone_Click"/>
                        <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12" Content="&#xE74D;" ToolTip="Delete" Click="ReminderDelete_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Overdue}" Value="True">
                    <Setter TargetName="Due" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- To-do row -->
        <DataTemplate x:Key="TodoRow">
            <Border x:Name="Row" Background="Transparent" CornerRadius="10" Padding="6,4" Margin="0,1" Cursor="Hand" MouseLeftButtonUp="Todo_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="Check" Style="{StaticResource Icon}" Text="&#xE739;" Foreground="{DynamicResource SubTextBrush}"/>
                    <TextBlock x:Name="Label" Grid.Column="1" Text="{Binding Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="Del" Grid.Column="2" Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="10" Content="&#xE711;" Visibility="Hidden" Click="TodoDelete_Click"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Done}" Value="True">
                    <Setter TargetName="Check" Property="Text" Value="&#xE73D;"/>
                    <Setter TargetName="Check" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                    <Setter TargetName="Label" Property="TextDecorations" Value="Strikethrough"/>
                    <Setter TargetName="Label" Property="Opacity" Value="0.5"/>
                </DataTrigger>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}"/>
                    <Setter TargetName="Del" Property="Visibility" Value="Visible"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root" TextElement.Foreground="{DynamicResource TextBrush}" TextElement.FontFamily="{StaticResource UiFont}" TextElement.FontSize="13">
        <!-- The island. Its size and corner radius are animated from code. -->
        <Border x:Name="Island"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Width="200" Height="34" CornerRadius="17"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource SurfaceEdgeBrush}" BorderThickness="1"
                AllowDrop="True" ClipToBounds="True"
                MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave"
                MouseLeftButtonUp="Island_Click"
                DragEnter="Island_DragEnter" DragOver="Island_DragOver" DragLeave="Island_DragLeave" Drop="Island_Drop">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35" Color="Black" RenderingBias="Performance"/>
            </Border.Effect>

            <Grid>
                <!-- glossy sheen layer -->
                <Border Background="{DynamicResource SheenBrush}" IsHitTestVisible="False" CornerRadius="{Binding CornerRadius, ElementName=Island}"/>

                <!-- ============ COMPACT ============ -->
                <Grid x:Name="Compact" Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- left: artwork or status icon -->
                    <Grid Grid.Column="0" VerticalAlignment="Center">
                        <Border x:Name="CompactArtBox" Width="22" Height="22" CornerRadius="6" Visibility="Collapsed">
                            <Border.Background>
                                <ImageBrush x:Name="CompactArt" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <TextBlock x:Name="CompactIcon" Style="{StaticResource Icon}" FontSize="13" Text="&#xE823;" Foreground="{DynamicResource SubTextBrush}"/>
                    </Grid>

                    <!-- centre: time, title, timer -->
                    <TextBlock x:Name="CompactText" Grid.Column="1" Margin="8,0" VerticalAlignment="Center" HorizontalAlignment="Center"
                               FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="12:00"/>

                    <!-- right: equaliser / mic / call timer -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel x:Name="CallPill" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,6,0">
                            <Ellipse Width="7" Height="7" Fill="#3DDC84" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock x:Name="CallTime" FontSize="11.5" FontWeight="SemiBold" Text="0:00" Foreground="#3DDC84"/>
                        </StackPanel>
                        <TextBlock x:Name="MicMutedIcon" Style="{StaticResource Icon}" FontSize="13" Text="&#xEC54;" Foreground="{StaticResource DangerBrush}" Visibility="Collapsed" Margin="0,0,6,0" ToolTip="Microphone muted (Ctrl+Alt+M)"/>
                        <StackPanel x:Name="Eq" Orientation="Horizontal" Height="14" Visibility="Collapsed">
                            <Rectangle x:Name="Eq1" Width="3" RadiusX="1.5" RadiusY="1.5" Margin="1,0" Fill="{DynamicResource AccentBrush}" Height="14" RenderTransformOrigin="0.5,1"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.4"/></Rectangle.RenderTransform></Rectangle>
                            <Rectangle x:Name="Eq2" Width="3" RadiusX="1.5" RadiusY="1.5" Margin="1,0" Fill="{DynamicResource AccentBrush}" Height="14" RenderTransformOrigin="0.5,1"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.8"/></Rectangle.RenderTransform></Rectangle>
                            <Rectangle x:Name="Eq3" Width="3" RadiusX="1.5" RadiusY="1.5" Margin="1,0" Fill="{DynamicResource AccentBrush}" Height="14" RenderTransformOrigin="0.5,1"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.6"/></Rectangle.RenderTransform></Rectangle>
                            <Rectangle x:Name="Eq4" Width="3" RadiusX="1.5" RadiusY="1.5" Margin="1,0" Fill="{DynamicResource AccentBrush}" Height="14" RenderTransformOrigin="0.5,1"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform></Rectangle>
                        </StackPanel>
                        <TextBlock x:Name="CompactRight" Style="{StaticResource Sub}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- ============ PEEK (notification / reminder / status) ============ -->
                <Grid x:Name="Peek" Margin="14,8" Visibility="Collapsed" Opacity="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource CardBrush}" VerticalAlignment="Center">
                        <TextBlock x:Name="PeekIcon" Style="{StaticResource Icon}" Text="&#xEA8F;" Foreground="{DynamicResource AccentBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="PeekTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="PeekBody" Style="{StaticResource Sub}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>

                <!-- ============ EXPANDED ============ -->
                <DockPanel x:Name="Expanded" Margin="14,10,14,14" Visibility="Collapsed" Opacity="0">
                    <!-- top bar -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <RadioButton x:Name="TabHome" Style="{StaticResource TabButton}" Content="&#xE80F;" ToolTip="Home" IsChecked="True" Checked="Tab_Checked"/>
                            <RadioButton x:Name="TabClip" Style="{StaticResource TabButton}" Content="&#xE77F;" ToolTip="Clipboard" Checked="Tab_Checked"/>
                            <RadioButton x:Name="TabShelf" Style="{StaticResource TabButton}" Content="&#xE7B8;" ToolTip="File shelf" Checked="Tab_Checked"/>
                            <RadioButton x:Name="TabControls" Style="{StaticResource TabButton}" Content="&#xE9E9;" ToolTip="Quick controls" Checked="Tab_Checked"/>
                            <RadioButton x:Name="TabNotes" Style="{StaticResource TabButton}" Content="&#xEA8F;" ToolTip="Notifications" Checked="Tab_Checked"/>
                            <RadioButton x:Name="TabReminders" Style="{StaticResource TabButton}" Content="&#xE823;" ToolTip="Reminders and to-do" Checked="Tab_Checked"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="HeaderClock" Style="{StaticResource Sub}" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Settings" Click="Settings_Click"/>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="Pages">
                        <!-- ===== HOME ===== -->
                        <Grid x:Name="PageHome">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- media -->
                            <Border Style="{StaticResource Tile}" Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="84" Height="84" CornerRadius="14" Background="{DynamicResource TrackBrush}">
                                            <Grid>
                                                <TextBlock x:Name="ArtPlaceholder" Style="{StaticResource Icon}" FontSize="28" Text="&#xE8D6;" Foreground="{DynamicResource SubTextBrush}"/>
                                                <Border CornerRadius="14">
                                                    <Border.Background>
                                                        <ImageBrush x:Name="MediaArt" Stretch="UniformToFill"/>
                                                    </Border.Background>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,2,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="MediaApp" Style="{StaticResource Sub}" Text="Nothing playing"/>
                                            <TextBlock x:Name="MediaTitle" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            <TextBlock x:Name="MediaArtist" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="2" Margin="0,12,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Slider x:Name="MediaProgress" Style="{StaticResource ThinSlider}" Minimum="0" Maximum="1"
                                                PreviewMouseLeftButtonDown="Progress_Down" PreviewMouseLeftButtonUp="Progress_Up"/>
                                        <Grid Grid.Row="1">
                                            <TextBlock x:Name="MediaPos" Style="{StaticResource Sub}" Text="0:00"/>
                                            <TextBlock x:Name="MediaDur" Style="{StaticResource Sub}" Text="0:00" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Grid>

                                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                        <Button Style="{StaticResource IconButton}" Width="40" Height="40" FontSize="16" Content="&#xE892;" Click="Prev_Click"/>
                                        <Button x:Name="PlayPause" Style="{StaticResource IconButton}" Width="48" Height="48" FontSize="22" Content="&#xE768;" Margin="10,0" Click="PlayPause_Click"/>
                                        <Button Style="{StaticResource IconButton}" Width="40" Height="40" FontSize="16" Content="&#xE893;" Click="Next_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- widgets -->
                            <UniformGrid Grid.Column="1" Columns="2" Rows="2">
                                <!-- clock + weather -->
                                <Border Style="{StaticResource Tile}">
                                    <StackPanel>
                                        <TextBlock x:Name="BigClock" FontSize="30" FontWeight="Light" Text="12:00"/>
                                        <TextBlock x:Name="BigDate" Style="{StaticResource Sub}"/>
                                        <StackPanel x:Name="WeatherBox" Orientation="Horizontal" Margin="0,10,0,0" Cursor="Hand" MouseLeftButtonUp="Weather_Click">
                                            <TextBlock x:Name="WeatherIcon" Style="{StaticResource Icon}" FontSize="20" Text="&#xE706;" Foreground="{DynamicResource AccentBrush}"/>
                                            <StackPanel Margin="8,0,0,0">
                                                <TextBlock x:Name="WeatherTemp" FontWeight="SemiBold" Text="Set your city"/>
                                                <TextBlock x:Name="WeatherDesc" Style="{StaticResource Sub}" Text="in Settings"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- PC stats -->
                                <Border Style="{StaticResource Tile}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Sub}" Text="PC" Margin="0,0,0,6"/>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="CPU" Width="40" HorizontalAlignment="Left" FontSize="12"/>
                                            <ProgressBar x:Name="CpuBar" Height="5" Margin="42,0,40,0" Maximum="100" Background="{DynamicResource TrackBrush}" Foreground="{DynamicResource AccentBrush}" BorderThickness="0"/>
                                            <TextBlock x:Name="CpuText" HorizontalAlignment="Right" FontSize="12"/>
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="RAM" Width="40" HorizontalAlignment="Left" FontSize="12"/>
                                            <ProgressBar x:Name="RamBar" Height="5" Margin="42,0,40,0" Maximum="100" Background="{DynamicResource TrackBrush}" Foreground="{DynamicResource AccentBrush}" BorderThickness="0"/>
                                            <TextBlock x:Name="RamText" HorizontalAlignment="Right" FontSize="12"/>
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="GPU" Width="40" HorizontalAlignment="Left" FontSize="12"/>
                                            <ProgressBar x:Name="GpuBar" Height="5" Margin="42,0,40,0" Maximum="100" Background="{DynamicResource TrackBrush}" Foreground="{DynamicResource AccentBrush}" BorderThickness="0"/>
                                            <TextBlock x:Name="GpuText" HorizontalAlignment="Right" FontSize="12"/>
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock x:Name="BatteryIcon" Style="{StaticResource Icon}" HorizontalAlignment="Left" FontSize="13" Text="&#xE83F;"/>
                                            <ProgressBar x:Name="BatteryBar" Height="5" Margin="42,0,40,0" Maximum="100" Background="{DynamicResource TrackBrush}" Foreground="#3DDC84" BorderThickness="0"/>
                                            <TextBlock x:Name="BatteryText" HorizontalAlignment="Right" FontSize="12"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- world clocks -->
                                <Border Style="{StaticResource Tile}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Sub}" Text="World" Margin="0,0,0,4"/>
                                        <ItemsControl x:Name="WorldList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <TextBlock Text="{Binding Label}" FontSize="12"/>
                                                        <TextBlock Text="{Binding Time}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- timer -->
                                <Border Style="{StaticResource Tile}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource Sub}" Text="Timer"/>
                                        <TextBlock x:Name="TimerText" Grid.Row="1" FontSize="26" FontWeight="Light" Text="00:00" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                                            <Button Style="{StaticResource PillButton}" Padding="8,4" Content="1m" Tag="1" Click="TimerPreset_Click" Margin="0,0,3,0"/>
                                            <Button Style="{StaticResource PillButton}" Padding="8,4" Content="5m" Tag="5" Click="TimerPreset_Click" Margin="0,0,3,0"/>
                                            <Button Style="{StaticResource PillButton}" Padding="8,4" Content="25m" Tag="25" Click="TimerPreset_Click" Margin="0,0,3,0"/>
                                            <Button x:Name="TimerStop" Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="11" Content="&#xE71A;" ToolTip="Stop" Click="TimerStop_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </UniformGrid>
                        </Grid>

                        <!-- ===== CLIPBOARD ===== -->
                        <DockPanel x:Name="PageClip" Visibility="Collapsed">
                            <Grid DockPanel.Dock="Top" Margin="4,0,4,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton Style="{StaticResource Chip}" Content="All" Tag="All" IsChecked="True" GroupName="ClipFilter" Checked="ClipFilter_Checked"/>
                                    <RadioButton Style="{StaticResource Chip}" Content="Pinned" Tag="Pinned" GroupName="ClipFilter" Checked="ClipFilter_Checked"/>
                                    <RadioButton Style="{StaticResource Chip}" Content="Text" Tag="Text" GroupName="ClipFilter" Checked="ClipFilter_Checked"/>
                                    <RadioButton Style="{StaticResource Chip}" Content="Links" Tag="Link" GroupName="ClipFilter" Checked="ClipFilter_Checked"/>
                                    <RadioButton Style="{StaticResource Chip}" Content="Images" Tag="Image" GroupName="ClipFilter" Checked="ClipFilter_Checked"/>
                                    <RadioButton Style="{StaticResource Chip}" Content="Files" Tag="Files" GroupName="ClipFilter" Checked="ClipFilter_Checked"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBox x:Name="ClipSearch" Style="{StaticResource Field}" Width="160" Tag="Search" TextChanged="ClipSearch_Changed"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Clear all except pinned" Click="ClipClear_Click" Margin="4,0,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <ListBox x:Name="ClipList" Style="{StaticResource PlainList}" ItemTemplate="{StaticResource ClipRow}"/>
                                <TextBlock x:Name="ClipEmpty" Style="{StaticResource Sub}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Copy something and it shows up here." Visibility="Collapsed"/>
                            </Grid>
                        </DockPanel>

                        <!-- ===== SHELF ===== -->
                        <Grid x:Name="PageShelf" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DockPanel Margin="0,0,8,0">
                                <Button DockPanel.Dock="Bottom" Style="{StaticResource PillButton}" Content="+ New folder" Click="ShelfNewFolder_Click" Margin="0,6,0,0"/>
                                <ListBox x:Name="FolderList" Style="{StaticResource PlainList}" SelectionChanged="Folder_Changed">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Row" CornerRadius="10" Padding="10,7" Margin="0,1" Background="Transparent" Cursor="Hand"
                                                    AllowDrop="True" Drop="Folder_Drop" MouseLeftButtonUp="Folder_Click">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Delete folder" Click="FolderDelete_Click"/>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="13" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource CardBrush}"/>
                                                </DataTrigger>
                                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                            <Border Grid.Column="1" x:Name="ShelfDrop" CornerRadius="16" BorderThickness="1.5" BorderBrush="{DynamicResource TrackBrush}" Background="Transparent">
                                <Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="ShelfItems" ItemTemplate="{StaticResource ShelfTile}" Margin="6">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <StackPanel x:Name="ShelfEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock Style="{StaticResource Icon}" FontSize="28" Text="&#xE896;" Foreground="{DynamicResource SubTextBrush}"/>
                                        <TextBlock Style="{StaticResource Sub}" Margin="0,8,0,0" Text="Drop files on the island to keep them here."/>
                                        <TextBlock Style="{StaticResource Sub}" HorizontalAlignment="Center" Text="Drag them back out into any app."/>
                                    </StackPanel>
                                    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6" Content="&#xE74D;" ToolTip="Clear this folder" Click="ShelfClear_Click"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ===== CONTROLS ===== -->
                        <Grid x:Name="PageControls" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource Tile}">
                                <StackPanel>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="44"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="SpeakerBtn" Style="{StaticResource IconButton}" Content="&#xE767;" ToolTip="Mute speakers" Click="SpeakerMute_Click"/>
                                        <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource ThinSlider}" Minimum="0" Maximum="100" VerticalAlignment="Center" ValueChanged="Volume_Changed"/>
                                        <TextBlock x:Name="VolumeText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid x:Name="BrightnessRow" Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="44"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE706;"/>
                                        <Slider x:Name="BrightnessSlider" Grid.Column="1" Style="{StaticResource ThinSlider}" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                                PreviewMouseLeftButtonUp="Brightness_Commit" ValueChanged="Brightness_Changed"/>
                                        <TextBlock x:Name="BrightnessText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <UniformGrid Grid.Row="1" Columns="3" Margin="1,0">
                                <ToggleButton x:Name="WifiTile" Style="{StaticResource ToggleTile}" Click="Wifi_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" FontSize="16" Text="&#xE701;" VerticalAlignment="Center" Margin="2,0,10,0"/>
                                        <StackPanel><TextBlock Text="Wi-Fi" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/><TextBlock x:Name="WifiState" FontSize="11" Opacity="0.75" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/></StackPanel>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="BtTile" Style="{StaticResource ToggleTile}" Click="Bluetooth_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" FontSize="16" Text="&#xE702;" VerticalAlignment="Center" Margin="2,0,10,0"/>
                                        <StackPanel><TextBlock Text="Bluetooth" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/><TextBlock x:Name="BtState" FontSize="11" Opacity="0.75" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/></StackPanel>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="MicTile" Style="{StaticResource ToggleTile}" Click="MicTile_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="MicTileIcon" FontFamily="{StaticResource IconFont}" FontSize="16" Text="&#xE720;" VerticalAlignment="Center" Margin="2,0,10,0"/>
                                        <StackPanel><TextBlock Text="Mic mute" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/><TextBlock Text="Ctrl+Alt+M" FontSize="11" Opacity="0.75" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/></StackPanel>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Style="{StaticResource ToggleTile}" Click="NightLight_Click" ToolTip="Opens Night light settings">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" FontSize="16" Text="&#xE708;" VerticalAlignment="Center" Margin="2,0,10,0"/>
                                        <StackPanel><TextBlock Text="Night light" FontWeight="SemiBold"/><TextBlock Text="Settings" FontSize="11" Opacity="0.75"/></StackPanel>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Style="{StaticResource ToggleTile}" Click="Focus_Click" ToolTip="Opens Focus settings">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" FontSize="16" Text="&#xE916;" VerticalAlignment="Center" Margin="2,0,10,0"/>
                                        <StackPanel><TextBlock Text="Focus" FontWeight="SemiBold"/><TextBlock Text="Settings" FontSize="11" Opacity="0.75"/></StackPanel>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Style="{StaticResource ToggleTile}" Click="DisplaySettings_Click" ToolTip="Opens Display settings">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" FontSize="16" Text="&#xE7F4;" VerticalAlignment="Center" Margin="2,0,10,0"/>
                                        <StackPanel><TextBlock Text="Display" FontWeight="SemiBold"/><TextBlock Text="Settings" FontSize="11" Opacity="0.75"/></StackPanel>
                                    </StackPanel>
                                </ToggleButton>
                            </UniformGrid>

                            <Border Grid.Row="2" Style="{StaticResource Tile}">
                                <Grid>
                                    <TextBlock Text="Power mode" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <RadioButton x:Name="PowerEff" Style="{StaticResource Chip}" Content="Efficiency" GroupName="Power" Click="Power_Click"/>
                                        <RadioButton x:Name="PowerBal" Style="{StaticResource Chip}" Content="Balanced" GroupName="Power" Click="Power_Click"/>
                                        <RadioButton x:Name="PowerPerf" Style="{StaticResource Chip}" Content="Performance" GroupName="Power" Click="Power_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ===== NOTIFICATIONS ===== -->
                        <DockPanel x:Name="PageNotes" Visibility="Collapsed">
                            <Grid DockPanel.Dock="Top" Margin="4,0,4,6">
                                <TextBlock x:Name="NotesStatus" Style="{StaticResource Sub}" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource PillButton}" HorizontalAlignment="Right" Content="Clear all" Click="NotesClear_Click"/>
                            </Grid>
                            <Grid>
                                <ListBox x:Name="NotesList" Style="{StaticResource PlainList}" ItemTemplate="{StaticResource NoteRow}"/>
                                <TextBlock x:Name="NotesEmpty" Style="{StaticResource Sub}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="No notifications yet."/>
                            </Grid>
                        </DockPanel>

                        <!-- ===== REMINDERS + TO-DO ===== -->
                        <Grid x:Name="PageReminders" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="230"/>
                            </Grid.ColumnDefinitions>
                            <DockPanel Margin="0,0,10,0">
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ReminderText" Style="{StaticResource Field}" Tag="Remind me to…" KeyDown="ReminderInput_KeyDown"/>
                                    <TextBox x:Name="ReminderWhen" Grid.Column="1" Style="{StaticResource Field}" Tag="in 10m / 5pm" Margin="4,0,0,0" KeyDown="ReminderInput_KeyDown"/>
                                    <ComboBox x:Name="ReminderRepeat" Grid.Column="2" Margin="4,0,0,0" Width="90" VerticalContentAlignment="Center" SelectedIndex="0">
                                        <ComboBoxItem Content="Once"/>
                                        <ComboBoxItem Content="Daily"/>
                                        <ComboBoxItem Content="Weekdays"/>
                                        <ComboBoxItem Content="Weekly"/>
                                        <ComboBoxItem Content="Monthly"/>
                                    </ComboBox>
                                    <Button Grid.Column="3" Style="{StaticResource AccentPill}" Content="Add" Margin="4,0,0,0" Click="ReminderAdd_Click"/>
                                </Grid>
                                <TextBlock x:Name="ReminderHint" DockPanel.Dock="Top" Style="{StaticResource Sub}" Margin="4,0,0,4" Text="Try: in 20m, at 6pm, tomorrow 9am, 17:30"/>
                                <ListBox x:Name="ReminderList" Style="{StaticResource PlainList}" ItemTemplate="{StaticResource ReminderRow}"/>
                            </DockPanel>
                            <Border Grid.Column="1" Style="{StaticResource Tile}" Margin="0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Sub}" Text="To-do" Margin="2,0,0,6"/>
                                    <TextBox x:Name="TodoInput" DockPanel.Dock="Top" Style="{StaticResource Field}" Tag="Add a task and press Enter" KeyDown="TodoInput_KeyDown" Margin="0,0,0,6"/>
                                    <ListBox x:Name="TodoList" Style="{StaticResource PlainList}" ItemTemplate="{StaticResource TodoRow}"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
