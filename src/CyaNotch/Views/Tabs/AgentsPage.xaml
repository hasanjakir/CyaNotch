<UserControl x:Class="CyaNotch.Views.Tabs.AgentsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>

        <!-- sessions -->
        <DockPanel>
            <TextBlock x:Name="Summary" DockPanel.Dock="Top" Style="{StaticResource Sub}" Margin="4,0,0,6"/>
            <Grid>
                <ListBox x:Name="List" Style="{StaticResource PlainList}" SelectionChanged="List_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Row" Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="12,8" Margin="0,2" Cursor="Hand">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="Dot" Width="9" Height="9" Margin="0,5,10,0" VerticalAlignment="Top" Fill="#8F94A0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock>
                                            <Run Text="{Binding Agent, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text="  "/>
                                            <Run Text="{Binding Folder, Mode=OneWay}" Foreground="{DynamicResource SubTextBrush}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding LastStep, Mode=OneWay}" Style="{StaticResource Sub}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                        <TextBlock x:Name="StateText" Text="{Binding StateText, Mode=OneWay}" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding Ago, Mode=OneWay}" Style="{StaticResource Sub}" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding StateText}" Value="Needs you">
                                    <Setter TargetName="Dot" Property="Fill" Value="#FFB020"/>
                                    <Setter TargetName="StateText" Property="Foreground" Value="#FFB020"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StateText}" Value="Working">
                                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StateText}" Value="Done">
                                    <Setter TargetName="Dot" Property="Fill" Value="#3DDC84"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="Empty" Style="{StaticResource Sub}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                           Text="No agents running right now.&#x0a;Start Claude Code or Codex and they'll show up here."/>
            </Grid>
        </DockPanel>

        <!-- timeline / setup -->
        <Border Grid.Column="1" Style="{StaticResource Tile}" Margin="8,0,0,0">
            <Grid>
                <DockPanel x:Name="Timeline" Visibility="Collapsed">
                    <TextBlock x:Name="TimelineTitle" DockPanel.Dock="Top" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Sub}" Text="Steps" Margin="0,2,0,6"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="Steps">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Time}" Style="{StaticResource Sub}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding What}" FontSize="12" TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
                <StackPanel x:Name="Setup">
                    <TextBlock Text="Live status from Claude Code" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource Sub}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="Without setup, CyaNotch sees when a Claude Code or Codex session is busy. Connect Claude Code to also see each step, and get a pop-up when it needs you or finishes. This adds small hooks to your Claude Code settings (a backup is kept)."/>
                    <Button x:Name="ConnectBtn" Style="{StaticResource AccentPill}" HorizontalAlignment="Left" Margin="0,10,0,0" Content="Connect Claude Code" Click="Connect_Click"/>
                    <TextBlock x:Name="ConnectState" Style="{StaticResource Sub}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <TextBlock Style="{StaticResource Sub}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"
                               Text="Other agents can report by sending JSON to this PC:"/>
                    <TextBox x:Name="CustomHint" Style="{StaticResource Field}" IsReadOnly="True" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
