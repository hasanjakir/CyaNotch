<UserControl x:Class="CyaNotch.Views.Tabs.CallsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- big mic button -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Button x:Name="MicBtn" Width="132" Height="132" Cursor="Hand" Focusable="False" Click="Mic_Click" ToolTip="Mute or unmute your mic in every app (Ctrl+Alt+M)">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="66" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock x:Name="MicGlyph" Style="{StaticResource Icon}" FontSize="46" Text="&#xE720;"/>
            </Button>
            <TextBlock x:Name="MicState" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
            <TextBlock x:Name="InUse" Style="{StaticResource Sub}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
        </StackPanel>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,6,0">
            <TextBlock Text="Microphone" FontWeight="SemiBold"/>
            <TextBlock x:Name="MicName" Style="{StaticResource Sub}" TextTrimming="CharacterEllipsis" Margin="0,2,0,8"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Height="10" CornerRadius="5" Background="{DynamicResource TrackBrush}" VerticalAlignment="Center">
                    <Border x:Name="Level" HorizontalAlignment="Left" Width="0" CornerRadius="5" Background="{DynamicResource AccentBrush}"/>
                </Border>
                <Button x:Name="MicTestBtn" Grid.Column="1" Style="{StaticResource PillButton}" Content="Test mic" Margin="10,0,0,0" Click="MicTest_Click"/>
            </Grid>
            <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" Text="Speak: the bar should move. It stops on its own after 15 seconds."/>

            <TextBlock Text="Speaker" FontWeight="SemiBold" Margin="0,18,0,0"/>
            <TextBlock x:Name="SpeakerName" Style="{StaticResource Sub}" TextTrimming="CharacterEllipsis" Margin="0,2,0,8"/>
            <Button Style="{StaticResource PillButton}" HorizontalAlignment="Left" Content="Play a test sound" Click="SpeakerTest_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
