<UserControl x:Class="CyaNotch.Views.Tabs.WebPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <!-- pinned sites -->
        <Grid DockPanel.Dock="Top" Margin="2,0,2,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="Sites" Orientation="Horizontal"/>
            </ScrollViewer>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBox x:Name="NewUrl" Style="{StaticResource Field}" Width="200" Tag="Pin a site: example.com" KeyDown="NewUrl_KeyDown"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Reload" Click="Reload_Click" Margin="4,0,0,0"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE8A7;" ToolTip="Open in your browser" Click="OpenExternal_Click"/>
            </StackPanel>
        </Grid>
        <Border CornerRadius="16" ClipToBounds="True" Background="{DynamicResource CardBrush}">
            <Grid x:Name="Host">
                <TextBlock x:Name="Hint" Style="{StaticResource Sub}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                           Text="Pick a pinned site above. Right-click a site to unpin it."/>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
