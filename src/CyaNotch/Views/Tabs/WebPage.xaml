<UserControl x:Class="CyaNotch.Views.Tabs.WebPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- pinned sites -->
        <DockPanel x:Name="SitesView">
            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Sub}" FontSize="10.5" Margin="4,4,0,0"
                       Text="Add a site: any page, signed in, one click away. Right-click a site to unpin it."/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <WrapPanel x:Name="Sites"/>
            </ScrollViewer>
        </DockPanel>

        <!-- the small browser -->
        <DockPanel x:Name="BrowserView" Visibility="Collapsed">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="11" Content="&#xE72B;" ToolTip="Back to sites" Click="Back_Click"/>
                    <TextBlock x:Name="BrowserTitle" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="230"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="11" Content="&#xE72C;" ToolTip="Reload" Click="Reload_Click"/>
                    <Button Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="11" Content="&#xE8A7;" ToolTip="Open in your browser" Click="OpenExternal_Click"/>
                </StackPanel>
            </Grid>
            <Border CornerRadius="14" ClipToBounds="True" Background="{DynamicResource CardBrush}">
                <Grid x:Name="Host">
                    <TextBlock x:Name="Hint" Style="{StaticResource Sub}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="12"/>
                </Grid>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
