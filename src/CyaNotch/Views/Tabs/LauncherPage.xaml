<UserControl x:Class="CyaNotch.Views.Tabs.LauncherPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="4,0,4,8">
            <TextBlock Style="{StaticResource Sub}" VerticalAlignment="Center"
                       Text="Click to open. Ctrl+Alt+1 to 9 open the first nine, even over games. Drop apps here to add them."/>
            <Button Style="{StaticResource PillButton}" HorizontalAlignment="Right" Content="Add app" Click="Add_Click"/>
        </Grid>
        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Apps">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Tile" Width="88" Height="92" CornerRadius="16" Margin="3" Padding="6" Background="Transparent"
                                    Cursor="Hand" ToolTip="{Binding Path}" MouseLeftButtonUp="App_Click">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Remove" Click="Remove_Click"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="50"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Image Source="{Binding Icon}" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="{Binding Key}" Style="{StaticResource Sub}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                    <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="11.5" TextAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="30"/>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Tile" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="Empty" Style="{StaticResource Sub}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Text="No apps yet. Drop shortcuts or .exe files here, or press Add app."/>
        </Grid>
    </DockPanel>
</UserControl>
