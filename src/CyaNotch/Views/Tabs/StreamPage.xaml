<UserControl x:Class="CyaNotch.Views.Tabs.StreamPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- captures -->
        <Border Style="{StaticResource Tile}">
            <StackPanel>
                <TextBlock Style="{StaticResource Sub}" Text="Capture"/>
                <UniformGrid Columns="3" Margin="0,10,0,0">
                    <Button Style="{StaticResource PillButton}" Margin="0,0,4,0" Click="Shot_Click" ToolTip="Save the screen under the pointer">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Icon}" FontSize="20" Text="&#xE722;"/>
                            <TextBlock Text="Screenshot" FontSize="11.5" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PillButton}" Margin="2,0" Click="Snip_Click" ToolTip="Snip part of the screen">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Icon}" FontSize="20" Text="&#xE7A8;"/>
                            <TextBlock Text="Snip" FontSize="11.5" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="RecBtn" Style="{StaticResource PillButton}" Margin="4,0,0,0" Click="Rec_Click" ToolTip="Record the active app with its sound (Xbox Game Bar)">
                        <StackPanel>
                            <Ellipse x:Name="RecDot" Width="18" Height="18" Fill="{StaticResource DangerBrush}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="RecText" Text="Record" FontSize="11.5" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>
                <CheckBox x:Name="OnShelf" Content="Put screenshots on the shelf" Foreground="{DynamicResource TextBrush}" Margin="0,12,0,0" Click="OnShelf_Click"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Style="{StaticResource PillButton}" Content="Screenshots folder" Click="ShotsFolder_Click"/>
                    <Button Style="{StaticResource PillButton}" Content="Recordings" Margin="6,0,0,0" Click="RecFolder_Click"/>
                </StackPanel>

                <TextBlock Style="{StaticResource Sub}" Text="OBS" Margin="0,16,0,0"/>
                <CheckBox x:Name="ObsOn" Content="Show a REC / LIVE pill while OBS records or streams" Foreground="{DynamicResource TextBrush}" Margin="0,6,0,0" Click="Obs_Click"/>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ObsPort" Style="{StaticResource Field}" Tag="4455" LostFocus="ObsField_LostFocus"/>
                    <PasswordBox x:Name="ObsPass" Grid.Column="1" Margin="6,0,0,0" Padding="8,5" LostFocus="ObsField_LostFocus" ToolTip="OBS WebSocket password (Tools → WebSocket Server Settings)"/>
                </Grid>
                <TextBlock x:Name="ObsStatus" Style="{StaticResource Sub}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- chat -->
        <Border Grid.Column="1" Style="{StaticResource Tile}">
            <StackPanel>
                <TextBlock Style="{StaticResource Sub}" Text="Stream chat"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <RadioButton x:Name="Twitch" Style="{StaticResource Chip}" Content="Twitch" GroupName="Chat" Margin="0,0,6,0" Checked="Platform_Checked"/>
                    <RadioButton x:Name="YouTube" Style="{StaticResource Chip}" Content="YouTube" GroupName="Chat" Checked="Platform_Checked"/>
                </StackPanel>
                <TextBox x:Name="Channel" Style="{StaticResource Field}" Margin="0,10,0,0" LostFocus="Channel_LostFocus"/>
                <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="Opens the chat in a small window that stays on top, even over games in borderless mode. Drag and resize it anywhere."/>
                <Button x:Name="ChatBtn" Style="{StaticResource AccentPill}" HorizontalAlignment="Left" Margin="0,12,0,0" Content="Open chat" Click="Chat_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
