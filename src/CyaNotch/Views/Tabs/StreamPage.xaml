<UserControl x:Class="CyaNotch.Views.Tabs.StreamPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <!-- Screenshots / Recordings / Stream -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <RadioButton x:Name="ViewShots" Style="{StaticResource Seg}" Padding="10,3" Content="Screenshots" GroupName="CapView" IsChecked="True" Checked="View_Checked"/>
                <RadioButton x:Name="ViewRecs" Style="{StaticResource Seg}" Padding="10,3" Content="Recordings" GroupName="CapView" Checked="View_Checked"/>
                <RadioButton x:Name="ViewStream" Style="{StaticResource Seg}" Padding="10,3" Content="Stream" GroupName="CapView" Checked="View_Checked"/>
            </StackPanel>
            <Button Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="12" Content="&#xE8B7;" HorizontalAlignment="Right" ToolTip="Open the folder" Click="Folder_Click"/>
        </Grid>

        <Grid>
            <!-- gallery (screenshots or recordings) -->
            <DockPanel x:Name="GalleryView">
                <Grid DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <TextBlock x:Name="GalleryCount" Style="{StaticResource Sub}" FontSize="11" VerticalAlignment="Center"/>
                    <StackPanel x:Name="ShotActions" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource PillButton}" Padding="10,4" Click="Shot_Click" ToolTip="Save the screen under the pointer">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" FontSize="11" Text="&#xE722;" Margin="0,0,6,0"/>
                                <TextBlock Text="Screenshot" FontSize="11.5"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PillButton}" Padding="10,4" Margin="6,0,0,0" Click="Snip_Click" ToolTip="Snip part of the screen">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" FontSize="11" Text="&#xE7A8;" Margin="0,0,6,0"/>
                                <TextBlock Text="Snip" FontSize="11.5"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Button x:Name="RecBtn" HorizontalAlignment="Center" Cursor="Hand" Focusable="False" Visibility="Collapsed" Click="Rec_Click"
                            ToolTip="Record the active app with its sound (Xbox Game Bar)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="14" Background="{StaticResource DangerBrush}" Padding="14,5">
                                    <ContentPresenter/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle x:Name="RecDot" Width="9" Height="9" RadiusX="4.5" RadiusY="4.5" Fill="White" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock x:Name="RecText" Text="Start recording" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                    </Button>
                    <CheckBox x:Name="OnShelf" Content="On shelf" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}"
                              ToolTip="Put new screenshots on the shelf too" Click="OnShelf_Click"/>
                </Grid>
                <Grid>
                    <ScrollViewer x:Name="GalleryScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="Gallery_Wheel">
                        <StackPanel x:Name="Gallery" Orientation="Horizontal"/>
                    </ScrollViewer>
                    <TextBlock x:Name="GalleryEmpty" Style="{StaticResource Sub}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </DockPanel>

            <!-- OBS and chat -->
            <ScrollViewer x:Name="StreamView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="2,0">
                    <CheckBox x:Name="ObsOn" Content="REC / LIVE pill while OBS records or streams" FontSize="12" Foreground="{DynamicResource TextBrush}" Click="Obs_Click"/>
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ObsPort" Style="{StaticResource Field}" FontSize="11" Tag="4455" LostFocus="ObsField_LostFocus"/>
                        <PasswordBox x:Name="ObsPass" Grid.Column="1" Margin="6,0,0,0" Padding="8,4" LostFocus="ObsField_LostFocus" ToolTip="OBS WebSocket password (Tools → WebSocket Server Settings)"/>
                    </Grid>
                    <TextBlock x:Name="ObsStatus" Style="{StaticResource Sub}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    <Grid Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="Twitch" Style="{StaticResource Chip}" Content="Twitch" GroupName="Chat" Margin="0,0,6,0" Checked="Platform_Checked"/>
                            <RadioButton x:Name="YouTube" Style="{StaticResource Chip}" Content="YouTube" GroupName="Chat" Checked="Platform_Checked"/>
                        </StackPanel>
                        <Button x:Name="ChatBtn" Style="{StaticResource AccentPill}" HorizontalAlignment="Right" Content="Open chat" Click="Chat_Click"
                                ToolTip="A small chat window that stays on top, even over borderless games"/>
                    </Grid>
                    <TextBox x:Name="Channel" Style="{StaticResource Field}" FontSize="11" Margin="0,6,0,0" LostFocus="Channel_LostFocus"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
